---
config:
  layout: dagre
---
flowchart TD
    A0(["프로그램 시작: __main__"]) --> A1["StudyTimer() 인스턴스 생성"]
    A1 --> B0["__init__: 변수 및 윈도우/상태/AI/모델 등 초기화"]
    B0 --> B1["Tk()로 GUI 윈도우 생성"]
    B1 --> B2["타이머와 상태 관련 변수들 초기화"]
    B2 --> B3["격려 문구, 카메라 변수, 옵션 등 초기화"]
    B3 --> B4["self.root.protocol로 창닫기 핸들러 연결"]
    B4 --> B5["self.create_widgets() 호출"]
    B5 --> B6["메타데이터 파일 load → self.labels 저장"]
    B6 --> B7["학습 모델 load → self.model 저장"]
    B7 --> B8["mediapipe 포즈 객체, DrawingUtils 준비"]
    B8 --> B9["cv2.VideoCapture로 카메라 연결"]
    B9 --> B10["self.update_ai_frame() 호출"]
    B10 --> B11["self.start_continuous_messages() 호출"]

    B5 --> C0["create_widgets(): 화면 UI 위젯 배치"]
    C0 --> C1["그리드 레이아웃 row/column 설정"]
    C1 --> C2["타이머 구역 Frame, AI 구역 Frame 생성"]
    C2 --> C3["상태 라벨, 타이머 라벨, 버튼들(시작/정지, 리셋)"]
    C3 --> C4["카메라 선택 드롭다운"]
    C4 --> C5["AI 영상/결과/확률/카운트다운/격려문구 라벨"]

    C3 --> D0["Start 버튼 클릭 시: toggle_timer()"]
    D0 --> D1{"타이머 실행중?"}
    D1 -- 정지상태 --> D2["타이머 실행: 상태/버튼 UI 갱신, 타이머 업데이트 시작"]
    D2 --> D3["self.update_timer() 호출"]
    D1 -- 실행중 --> D4["타이머 일시정지: 경과 반영, 버튼/상태/UI 갱신, 업데이트 취소"]
    D4 --> D5["타이머 시간 포맷 변환 표시"]

    C3 --> D6["Reset 버튼 클릭 시: reset_timer()"]
    D6 --> D7["타이머/예약된 after 취소, 모든 상태/버튼 원상복구"]

    D3 --> E0["update_timer() 주기실행"]
    E0 --> E1{"실행중 & 시작시간 있음?"}
    E1 -- 예 --> E2["경과 시간 계산 → 타이머 라벨 표시 (200ms 후 재실행)"]
    E1 -- 아니오 --> E3["업데이트 취소"]

    B10 --> F0["update_ai_frame(): 카메라 프레임→ 주기적으로 AI 판독"]
    F0 --> F1["OpenCV로 frame 읽기"]
    F1 -- 실패 --> F2["카메라 연결 실패 표시, 잠시 후 재시도"]
    F1 -- 성공 --> F3{"타이머 실행중?"}
    F3 -- 아니오 --> F4@{ label: "'타이머를 시작해주세요' 문구, 카운트/확률 리셋, 카운트다운 예약취소" }
    F3 -- 예 --> F5["MediaPipe로 자세 데이터 추출"]
    F5 --> F6["KeyPoints 추출 및 패딩, 랜드마크 그리기, 모델 형태 맞춤"]
    F6 --> F7["self.model.predict → 분류결과/확률 계산"]
    F7 --> F8{"AI 모델이 예측한 결과? (Studying or Distracted)"}
    F8 -- Studying --> F9["공부 중 문구 표시, 실행 중인 미집중 카운트다운 있을 시 취소"]
    F8 -- Distracted --> F10{"카운트다운 이미 실행중?"}
    F10 -- 아니오 --> F11["self.remaining_secs=30, self.update_countdown()로 카운트다운 시작"]
    F10 -- 예 --> F12["실행 중인 미집중 카운트다운 유지"]
    F8 -- else --> F13["기타 행동"]
    F7 --> F14["확률 텍스트 라벨 상시 업데이트"]

    F11 --> G0["update_countdown()"]
    G0 --> G1{"남은 시간 > 0?"}
    G1 -- 예 --> G2@{ label: "'집중하지 않고 있음' 텍스트, 숫자 표시, 남은시간-1, 1초 후 재호출" }
    G1 -- 아니오 --> G3["카운트다운 종료: 타이머 강제 정지"]
    G3 --> G4["경과 반영, 상태 모두 정지, 버튼UI 갱신"]
    G4 --> G5["경고 메시지/라벨 표시"]
    G5 --> G6["메시지박스.showwarning() 팝업으로 미집중 안내"]

    B11 --> H0["start_continous_messages()"]
    H0 -- "self.always_show_message 값이 True" --> H1["update_pause_message() 호출"]
    H1 --> I0["update_pause_message(): 격려문구 랜덤 선택 → 라벨 표시"]
    I0 --> I2{"self.always_show_message 값이 True?"}
    I2 -- 예 --> I3["30초 후 update_pause_message() 재호출 (일정 주기마다 상시 반복)"]

    C4 --> J0["select_camera(selection)"]
    J0 --> J1["카메라 인덱스 찾기 → 기존 cap.release()"]
    J1 --> J2["새 cap = cv2.VideoCapture(index)"]
    J2 --> J3["카메라 전환 메세지 표시"]

    B4 --> K0["on_close()"]
    K0 --> K1["타이머/격려문구/카메라 등 예약된 after 모두 취소"]
    K1 --> K2["cap.release(), self.root.destroy()로 종료"]

    F4@{ shape: rect}
    G2@{ shape: rect}
    D1:::decision
    E1:::decision
    F3:::decision
    F8:::decision
    F10:::decision
    G1:::decision
    I2:::decision
    classDef decision fill:#FFF4BA,stroke:#B29500,stroke-width:2px
